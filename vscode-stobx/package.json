{
    "name": "stobx-language",
    "displayName": "STOBX Language",
    "description": "Syntax highlighting for STOBX",
    "version": "1.0.0",
    "publisher": "stobx",
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "stobx",
                "aliases": ["STOBX"],
                "extensions": [".stobx"],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "stobx",
                "scopeName": "source.stobx",
                "path": "./syntaxes/stobx.tmLanguage.json"
            }
        ]
    }
}

